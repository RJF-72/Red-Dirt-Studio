{
  "name": "red-dirt-rhythm-studio",
  "productName": "Red Dirt Rhythm Studio",
  "version": "1.0.0",
  "description": "Professional DAW with 0.4ms latency, AI vocal processing, and country-focused workflow",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --win --x64",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "DAW",
    "audio production",
    "music software",
    "country music",
    "vocal processing",
    "low latency"
  ],
  "author": "Red Dirt Rhythm Studio Team",
  "license": "MIT",
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.reddirt.rhythmsstudio",
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "compression": "store",
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "../red_dirt_teleprompter/target/release/rd_teleprompter.exe",
        "to": "teleprompter/rd_teleprompter.exe"
      }
    ],
    "files": [
      "**/*",
      "!All Instruments/**/*",
      "!node_modules/**/*",
      "!dist",
      "!build",
      "!*.md"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    }
  }
}